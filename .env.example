# AURA Personal Holographic Assistant - Environment Configuration

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_ENABLE_WAKE_WORD=true
VITE_DEFAULT_VOICE_PITCH=1.05
VITE_DEFAULT_VOICE_RATE=1.00

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional LLM API Keys (Built-in Demo Engine works out-of-the-box with NO keys required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local LLM Support (Ollama or LM Studio)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3:latest

# Security Guardrails
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE_ACTIONS=true
