# AURA Assistant - Backend Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# AI Providers (Optional - Built-in fallback available if not provided)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local LLM (Ollama or LM Studio)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3:latest

# Security
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE_ACTIONS=True
WORKSPACE_ROOT=../
